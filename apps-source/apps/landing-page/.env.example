# BeckCloud Landing Page — Environment Variables
# Copy to .env and fill in values

# === Server ===
PORT=8080
NODE_ENV=production
HOST=0.0.0.0

# === Keycloak (Auth) ===
KEYCLOAK_URL=http://keycloak.identity.svc.cluster.local:8080
KEYCLOAK_REALM=homelab
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=suCNJ5CtDdHEdy3Zhy6azwgG
KEYCLOAK_EXTERNAL_URL=https://keycloak.becklab.cloud

# === LLDAP (User Directory) ===
LLDAP_URL=http://lldap.identity.svc.cluster.local:17170
LLDAP_ADMIN_USERNAME=admin
LLDAP_ADMIN_PASSWORD=0VFdWI9LXWugx8H0LpV5hePG

# === Directus (CMS) ===
DIRECTUS_URL=http://directus.cms.svc.cluster.local:8055
DIRECTUS_TOKEN=your-directus-admin-token-here

# === Redis (Session & Cache) ===
REDIS_URL=redis://redis.identity.svc.cluster.local:6379

# === Prometheus (Monitoring) ===
PROMETHEUS_URL=http://prometheus.monitoring.svc.cluster.local:9090

# === SMTP (Email) ===
SMTP_HOST=smtp-relay.email.svc.cluster.local
SMTP_PORT=25
SMTP_FROM=noreply@becklab.cloud

# === Session / JWT ===
SESSION_SECRET=beckcloud-session-secret-change-me
JWT_SECRET=beckcloud-jwt-secret-change-me
JWT_EXPIRY_HOURS=720

# === Directus (for CMS content) ===
DIRECTUS_ADMIN_EMAIL=admin@becklab.cloud
DIRECTUS_ADMIN_PASSWORD=beckcloud-admin

# === GitHub (for git status in admin) ===
GITHUB_TOKEN=your-github-personal-access-token
GITHUB_REPO=yappingboy/beck-cloud
